<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="movements.movement_view.MovementCategoriesViewFX"
            styleClass="root-pane">

    <top>
        <HBox styleClass="header-bar">
            <Label text="EDITAR CATEGORÍAS" styleClass="header-title"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="form-panel" spacing="16">
            <Label text="Nombre:" styleClass="form-label"/>
            <VBox spacing="4">
                <TextField fx:id="txtNewNameCategory" styleClass="form-input" promptText="Nombre de la categoría"/>
                <Label text="Máximo 24 caracteres" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"/>
            </VBox>

            <Label text="Tipo:" styleClass="form-label"/>
            <ComboBox fx:id="cmbCategoryType" styleClass="form-input" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnConfirm" text="Agregar Categoría" styleClass="btn-primary" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="list-panel" spacing="12">
            <!-- Legend -->
            <HBox spacing="20" alignment="CENTER">
                <HBox spacing="6" alignment="CENTER">
                    <Region styleClass="color-income" style="-fx-min-width: 12px; -fx-min-height: 12px; -fx-max-width: 12px; -fx-max-height: 12px; -fx-background-radius: 6px;"/>
                    <Label text="Ingreso" styleClass="text-legend"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER">
                    <Region styleClass="color-expense" style="-fx-min-width: 12px; -fx-min-height: 12px; -fx-max-width: 12px; -fx-max-height: 12px; -fx-background-radius: 6px;"/>
                    <Label text="Egreso" styleClass="text-legend"/>
                </HBox>
            </HBox>

            <ListView fx:id="listCategories" styleClass="list-view" VBox.vgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnDeleteCategory" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="mdi2d-delete" iconSize="28"/></graphic>
                    <tooltip><Tooltip text="Eliminar categoría seleccionada"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
