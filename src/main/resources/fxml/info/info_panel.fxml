<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            styleClass="info-dialog">

    <content>
        <VBox spacing="20">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <HBox alignment="CENTER" spacing="15">
                <FontIcon iconLiteral="mdi2f-finance" iconSize="48" styleClass="info-logo"/>
                <VBox>
                    <Label text="Gestor de Finanzas" styleClass="info-title"/>
                    <Label text="Versión 2.0.0" styleClass="info-version"/>
                </VBox>
            </HBox>

            <Separator />

            <VBox spacing="10">
                <Label text="Cómo usar Gestor de Finanzas" styleClass="info-section-title"/>
                <Label text="Aprende a controlar tus finanzas de forma rápida y sencilla:" 
                       wrapText="true" styleClass="info-text"/>
                       
                <VBox spacing="8" styleClass="info-list">
                    <Label text="1. Mis Cuentas: Crea cuentas separadas para dividir tu dinero. Haz doble clic en una para entrar a su panel." wrapText="true"/>
                    <Label text="2. Movimientos: Registra ingresos y egresos diarios. El balance se calculará automáticamente." wrapText="true"/>
                    <Label text="3. Metas Financieras: Define objetivos a futuro y destina fondos poco a poco hasta completarlos." wrapText="true"/>
                    <Label text="4. Recordatorios y Recurrentes: Programa alertas para pagos futuros o automatiza tus gastos fijos mes a mes." wrapText="true"/>
                    <Label text="5. Notificaciones: Activa el modo 'Segundo Plano' en ajustes para recibir alertas incluso al cerrar la ventana principal." wrapText="true"/>
                </VBox>
            </VBox>
            
            <Separator />
            
            <VBox spacing="5" alignment="CENTER">
                <Label text="Desarrollado por RoastWare" styleClass="info-footer"/>
                <Label text="© 2026 Todos los derechos reservados." styleClass="info-footer-small"/>
            </VBox>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="CLOSE" />
    </buttonTypes>

</DialogPane>
