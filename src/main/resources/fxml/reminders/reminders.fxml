<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Reminders View Layout
    Controller: reminders.reminder_view.RemindersViewFX
    Stylesheet: /styles/app.css

    Note: Uses native JavaFX DatePicker — JCalendar dependency eliminated.
    TODO: Implement layout — Phase 3.4 (Reminders module migration)
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="reminders.reminder_view.RemindersViewFX"
            styleClass="root-pane">

    <top>
        <HBox styleClass="header-bar" spacing="15" alignment="CENTER_LEFT">
            <Label text="RECORDATORIOS" styleClass="header-title"/>
            <Label fx:id="lblAccountName"
                   style="-fx-background-color: rgba(255,255,255,0.15);
                          -fx-background-radius: 20px;
                          -fx-padding: 5px 15px;
                          -fx-text-fill: white;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVolver" text="Volver" styleClass="btn-back" 
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 4px;"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="form-panel" spacing="16">
            <Label text="Nombre:" styleClass="form-label"/>
            <TextField fx:id="txtReminderName" styleClass="form-input"
                       promptText="Reminder name"/>

            <Label text="Fecha:" styleClass="form-label"/>
            <DatePicker fx:id="datePicker" styleClass="form-input" maxWidth="Infinity"/>
            
            <Label text="Hora:" styleClass="form-label"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbHour" prefWidth="90" styleClass="form-input"/>
                <Label text=":" styleClass="form-label" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbMinute" prefWidth="90" styleClass="form-input"/>
            </HBox>
            <Label text="Mensaje:" styleClass="form-label"/>
            <TextField fx:id="txtMessage" styleClass="form-input"
                       promptText="Message content"/>

            <Button fx:id="btnAddReminder" text="Agregar Recordatorio"
                    styleClass="btn-primary" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="list-panel" spacing="12">
            <ListView fx:id="listReminders" styleClass="reminders-list" VBox.vgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnEditReminder" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="mdi2p-pencil" iconSize="28"/></graphic>
                    <tooltip><Tooltip text="Editar recordatorio seleccionado"/></tooltip>
                </Button>
                <Button fx:id="btnDeleteReminder" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="mdi2d-delete" iconSize="28"/></graphic>
                    <tooltip><Tooltip text="Eliminar recordatorio seleccionado"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
