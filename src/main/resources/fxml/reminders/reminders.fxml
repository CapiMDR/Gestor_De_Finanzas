<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Reminders View Layout
    Controller: reminders.reminder_view.RemindersViewFX
    Stylesheet: /styles/app.css

    Note: Uses native JavaFX DatePicker — JCalendar dependency eliminated.
    TODO: Implement layout — Phase 3.4 (Reminders module migration)
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="reminders.reminder_view.RemindersViewFX"
            styleClass="root-pane">

    <top>
        <HBox styleClass="header-bar">
            <Label text="RECORDATORIOS" styleClass="header-title"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="form-panel" spacing="16">
            <Label text="Nombre:" styleClass="form-label"/>
            <TextField fx:id="txtReminderName" styleClass="form-input"
                       promptText="Reminder name"/>

            <Label text="Fecha y Hora:" styleClass="form-label"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <DatePicker fx:id="datePicker" styleClass="form-input" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbHour" styleClass="form-input" prefWidth="75"/>
                <Label text=":" styleClass="form-label" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbMinute" styleClass="form-input" prefWidth="75"/>
            </HBox>
            <Label text="Mensaje:" styleClass="form-label"/>
            <TextField fx:id="txtMessage" styleClass="form-input"
                       promptText="Message content"/>

            <Button fx:id="btnAddReminder" text="Agregar Recordatorio"
                    styleClass="btn-primary" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="list-panel" spacing="12">
            <ListView fx:id="listReminders" styleClass="reminders-list" VBox.vgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnEditReminder" text="Editar" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="mdi2p-pencil" iconSize="28"/></graphic>
                    <tooltip><Tooltip text="Editar recordatorio seleccionado"/></tooltip>
                </Button>
                <Button fx:id="btnDeleteReminder" text="Eliminar" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="mdi2d-delete" iconSize="28"/></graphic>
                    <tooltip><Tooltip text="Eliminar recordatorio seleccionado"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
